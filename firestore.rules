rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth UID
    //   - email: string (required, immutable) - User email address
    //   - displayName: string (optional, max 100 chars) - Display name or company contact
    //   - companyName: string (optional, max 120 chars) - Associated company
    //   - role: string (required) - 'company' or 'reviewer'
    //   - createdAt: timestamp (required, immutable) - Account creation time
    //
    // Collection: verification_requests
    // Document ID: {requestId} (e.g. NVR-XXXXXX)
    // Fields:
    //   - id: string (required, immutable) - Human-readable request ID
    //   - trackingCode: string (required, immutable) - Verification tracking secret
    //   - company: string (required) - Company name (1-150 chars)
    //   - hrName: string (required) - HR representative name (1-100 chars)
    //   - hrEmail: string (required) - HR work email
    //   - hrPhone: string (optional, max 20 chars) - Contact phone
    //   - name: string (required) - Student full name (1-100 chars)
    //   - roll: string (required) - JNTUK roll number (10 chars alphanumeric)
    //   - branch: string (required) - Department/Branch
    //   - year: string (required) - Year of passing (4 digits)
    //   - types: list (required, 1-4 items) - Verified items ['degree', 'marks', 'backlogs', 'conduct']
    //   - status: string (required) - 'pending', 'approved', 'rejected'
    //   - remark: string (optional, max 500 chars) - College review note
    //   - decidedBy: string (optional, max 100 chars) - Name/Role of approver
    //   - decidedAt: timestamp (optional) - Decision timestamp
    //   - utr: string (optional, max 30 chars) - Payment reference
    //   - createdAt: timestamp (required, immutable) - Submission timestamp
    //   - createdByUid: string (optional, immutable) - Submitter's Auth UID (if authenticated)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCollegeAuthority() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@bvcgroup[.]in$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['reviewer', 'hod', 'principal', 'placement'])
      );
    }

    function isValidEmail(email) {
      return email is string && email.size() <= 120 && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
             hasOnlyAllowedFields(['uid', 'email', 'displayName', 'companyName', 'role', 'branch', 'createdAt']) &&
             data.uid == request.auth.uid &&
             isValidEmail(data.email) &&
             data.role in ['company', 'reviewer', 'hod', 'principal', 'placement'] &&
             data.createdAt is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 120)) &&
             (!('branch' in data) || (data.branch is string && data.branch.size() <= 50));
    }

    function isValidRequest(data) {
      return hasRequiredFields(['id', 'trackingCode', 'company', 'hrName', 'hrEmail', 'name', 'roll', 'branch', 'year', 'types', 'status', 'createdAt']) &&
             hasOnlyAllowedFields(['id', 'trackingCode', 'company', 'hrName', 'hrEmail', 'hrPhone', 'name', 'roll', 'branch', 'year', 'types', 'status', 'remark', 'decidedBy', 'decidedAt', 'utr', 'amount', 'paymentOrderId', 'createdAt', 'createdByUid']) &&
             data.id is string && data.id.size() >= 4 && data.id.size() <= 32 &&
             data.trackingCode is string && data.trackingCode.size() >= 4 && data.trackingCode.size() <= 64 &&
             data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
             data.hrName is string && data.hrName.size() > 0 && data.hrName.size() <= 100 &&
             isValidEmail(data.hrEmail) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.roll is string && data.roll.size() >= 4 && data.roll.size() <= 20 &&
             data.branch is string && data.branch.size() <= 50 &&
             data.year is string && data.year.size() >= 2 && data.year.size() <= 10 &&
             data.types is list && data.types.size() >= 1 && data.types.size() <= 10 &&
             data.status == 'pending' &&
             data.createdAt is timestamp &&
             (!('hrPhone' in data) || (data.hrPhone is string && data.hrPhone.size() <= 20)) &&
             (!('utr' in data) || (data.utr is string && data.utr.size() <= 60)) &&
             (!('paymentOrderId' in data) || (data.paymentOrderId is string && data.paymentOrderId.size() <= 60)) &&
             (!('amount' in data) || (data.amount is number || (data.amount is string && data.amount.size() <= 20))) &&
             (!('createdByUid' in data) || data.createdByUid == "" || (isAuthenticated() && data.createdByUid == request.auth.uid));
    }

    function isValidReviewUpdate() {
      let allowedDecisionKeys = ['status', 'remark', 'decidedBy', 'decidedAt'];
      return areImmutableFieldsUnchanged(['id', 'trackingCode', 'company', 'hrName', 'hrEmail', 'name', 'roll', 'branch', 'year', 'types', 'amount', 'paymentOrderId', 'createdAt', 'createdByUid']) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedDecisionKeys) &&
             request.resource.data.status in ['approved', 'rejected'] &&
             request.resource.data.decidedAt is timestamp &&
             (!('remark' in request.resource.data) || (request.resource.data.remark is string && request.resource.data.remark.size() <= 500)) &&
             (!('decidedBy' in request.resource.data) || (request.resource.data.decidedBy is string && request.resource.data.decidedBy.size() <= 100));
    }

    // ===============================================================
    // Rules Definition
    // ===============================================================

    // User profiles collection
    match /users/{userId} {
      // Users can only read their own profile; college authorities can inspect
      allow read: if isOwner(userId) || isCollegeAuthority();

      // Authenticated users can create profile; only @bvcgroup.in users can claim college authority roles
      allow create: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       (request.resource.data.role == 'company' ||
                        (request.resource.data.role in ['reviewer', 'hod', 'principal', 'placement'] && request.auth.token.email.matches('.*@bvcgroup[.]in$')));

      // Updates can only be made by the user themselves without changing immutable fields (uid, createdAt)
      // Only @bvcgroup.in faculty can update their role to authority roles
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
                       (request.resource.data.role == resource.data.role ||
                        (request.resource.data.role in ['reviewer', 'hod', 'principal', 'placement'] && request.auth.token.email.matches('.*@bvcgroup[.]in$')));

      allow delete: if false;
    }

    // Verification Requests collection
    match /verification_requests/{requestId} {
      // Authenticated creators can read their own requests; college authorities can read all
      // Public / guest status tracking allowed if querying document with matching trackingCode
      allow get: if (isAuthenticated() && (resource.data.createdByUid == request.auth.uid || isCollegeAuthority())) ||
                    (resource.data.trackingCode == request.auth.token.trackingCode || resource.data.id == requestId);

      allow list: if isAuthenticated() && (
        isCollegeAuthority() ||
        (request.query.limit <= 50)
      );

      // Authenticated users or unauthenticated guest submitters can submit a new valid request
      allow create: if isValidRequest(request.resource.data);

      // Only college authorities can update a request to approve/reject it
      allow update: if isCollegeAuthority() && isValidReviewUpdate();

      // Deletion is disallowed to preserve audit trail
      allow delete: if false;
    }
  }
}
